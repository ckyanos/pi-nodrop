{
  "dataset_manifest": "terminal-bench.json",
  "execution": "live-model",
  "audit": "on",
  "control_mode": "fixed-raw",
  "tasks": [
    "openssl-selfsigned-cert",
    "log-summary-date-ranges",
    "fix-git"
